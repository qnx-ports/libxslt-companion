pkgname=libxslt
pkgver=1.1.43
pkgrel=${pkgrel:-0}
pkgdesc="XML stylesheet transformation library"
url="http://xmlsoft.org/XSLT/"
arch="all"
license="X11"
depends="libxml2"
makedepends="
    libgcrypt-dev
    libgpg-error-dev
    libxml2-dev
    "
subpackages="
    $pkgname-static
    $pkgname-doc
    $pkgname-dev
    "
source="https://download.gnome.org/sources/libxslt/${pkgver%.*}/libxslt-$pkgver.tar.xz"

build() {
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --with-python=no \
        --enable-static \
        LDFLAGS=-Wl,-z,execstack,-z,stack-size=8388608
    make
}

check() {
    make check
}

package() {
    make DESTDIR="$pkgdir" install
    install -D -m644 Copyright -t "$pkgdir"/usr/share/licenses/$pkgname/
}

dev() {
    default_dev

    amove usr/lib/xsltConf.sh
}


options="$options ${DISABLE_CHECK:+!check}"
sha512sums="
96110b0397a8f5791f489127574e2143845feb61bea0581d7b7e3c1101fd0718483bae81a7ce417b971bd678293bfd95daddad0dadd3e256c87d41a69faed85a  libxslt-1.1.43.tar.xz
"
